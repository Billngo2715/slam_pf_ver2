<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_pf_icp</name>
  <version>0.3.0</version>
  <description>
    FastSLAM 1.0: mỗi hạt mang theo bản đồ riêng (shared_ptr OccupancyGridMap).
    ICP và likelihood dùng map của chính hạt đó.
    Chỉ update map cho top-K hạt tốt nhất sau mỗi vòng lặp.
    Publish bản đồ của hạt có weight cao nhất lên RViz.
  </description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>eigen3_cmake_module</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>